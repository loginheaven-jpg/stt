# env.local 의 본보기다. 이 파일을 env.local 로 복사하고 값을 채운다.
# env.local 은 .gitignore 에 걸려 있다. 값을 넣은 채로 올라가지 않는다.
#
# app.py(무료 로컬 트랙)는 HF_TOKEN 하나만 쓴다. 화자 분리를 하지 않으면 그것도 필요 없다.
# 나머지는 Phase 2 비교 도구(run_stt.py)용이다.

# 화자 분리 — huggingface.co/settings/tokens 에서 Read 권한으로 만든다.
# huggingface.co/pyannote/speaker-diarization-community-1 에서 약관에 먼저 동의한다.
HF_TOKEN=

# 아래는 run_stt.py 로 유료 엔진을 비교할 때만 채운다.
RTZR_CLIENT_ID=
RTZR_CLIENT_SECRET=
CLOVA_INVOKE_URL=
CLOVA_SECRET_KEY=
OPENAI_API_KEY=
